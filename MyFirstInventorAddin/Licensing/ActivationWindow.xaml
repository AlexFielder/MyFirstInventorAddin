<Window x:Class="iPropertiesController.Licensing.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate iPropertiesController"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,3" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <StackPanel x:Name="InputPanel">

            <!-- Default path: confirm the email address with an emailed one-time code. -->
            <StackPanel x:Name="EmailCodePanel">
                <TextBlock TextWrapping="Wrap"
                           Text="Enter your work email address. We'll email you a 6-digit code to confirm it's yours." />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Email address" />
                <TextBox x:Name="EmailBox" />
                <Button x:Name="SendCodeButton" Content="Send code" IsDefault="True"
                        HorizontalAlignment="Right" Margin="0,10,0,0" />

                <StackPanel x:Name="CodeEntryPanel" Visibility="Collapsed" Margin="0,6,0,0">
                    <TextBlock x:Name="CodeSentText" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Code" />
                    <TextBox x:Name="CodeBox" MaxLength="6" Width="120" HorizontalAlignment="Left"
                             FontSize="16" FontFamily="Consolas" />
                    <Button x:Name="ActivateWithCodeButton" Content="Activate"
                            HorizontalAlignment="Right" Margin="0,10,0,0" />
                </StackPanel>

                <TextBlock Margin="0,14,0,0">
                    <Hyperlink x:Name="UseActivationCodeLink">I have an activation code</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Alternative: an activation code issued by AF Automations. -->
            <StackPanel x:Name="ActivationCodePanel" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap"
                           Text="Enter your work email address and the activation code AF Automations sent you." />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Email address" />
                <TextBox x:Name="ActivationEmailBox" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Activation code" />
                <TextBox x:Name="ActivationCodeBox" FontFamily="Consolas" CharacterCasing="Upper" />
                <Button x:Name="ActivateWithActivationCodeButton" Content="Activate"
                        HorizontalAlignment="Right" Margin="0,10,0,0" />
                <TextBlock Margin="0,14,0,0">
                    <Hyperlink x:Name="UseEmailCodeLink">Email me a code instead</Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="Firebrick" Visibility="Collapsed" />

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" DockPanel.Dock="Right" />
            <TextBlock x:Name="InstallIdText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="11" />
        </DockPanel>
    </StackPanel>
</Window>
