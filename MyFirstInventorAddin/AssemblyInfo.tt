<#@ template debug="true" hostspecific="true" language="C#" #>
<#@ output extension=".vb" encoding="utf-8" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#
    // Same scheme as the other AF Automations Inventor/Vault add-ins: read the version from the
    // current AssemblyInfo.vb, add 1 to the last part on every build and 1 to the third on Release.
    string output = File.ReadAllText(this.Host.ResolvePath("AssemblyInfo.vb"));
    Regex pattern = new Regex("AssemblyVersion\\(\"(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<revision>\\d+)\\.(?<build>\\d+)\"\\)");
    MatchCollection matches = pattern.Matches(output);
    if( matches.Count == 1 )
    {
        major = Convert.ToInt32(matches[0].Groups["major"].Value);
        minor = Convert.ToInt32(matches[0].Groups["minor"].Value);
        build = Convert.ToInt32(matches[0].Groups["build"].Value) + 1;
        revision = Convert.ToInt32(matches[0].Groups["revision"].Value);
        if( this.Host.ResolveParameterValue("-","-","BuildConfiguration") == "Release" )
            revision++;
    }
#>
' <auto-generated>
'     Generated from AssemblyInfo.tt by the PreBuild target in iPropertiesController.vbproj.
'     Edit the template, not this file.
' </auto-generated>
Imports System.Reflection
