'The following GUID is for the ID of the typelib if this project is exposed to COM
<Assembly: Guid("be85cfee-b3c2-4c19-a2c9-15c5d126e2d4")>

' Inventor add-ins only run on Windows; this also stops the platform-compatibility (CA1416)
' warnings that the SDK's generated assembly info would otherwise suppress.
<Assembly: SupportedOSPlatform("windows")>

<Assembly: AssemblyVersion("<#= this.major #>.<#= this.minor #>.<#= this.revision #>.<#= this.build #>")>
<Assembly: AssemblyFileVersion("<#= this.major #>.<#= this.minor #>.<#= this.revision #>.<#= this.build #>")>
<#+
    int major = 2026;
    int minor = 0;
    int revision = 0;
    int build = 0;
#>