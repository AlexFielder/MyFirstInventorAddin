<UserControl x:Class="iPropertiesController.WpfSpikePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBack}"
             Foreground="{DynamicResource PanelFore}"
             PreviewKeyDown="Panel_PreviewKeyDown"
             PreviewTextInput="Panel_PreviewTextInput"
             SizeChanged="Panel_SizeChanged">
    <!-- Throwaway spike: proves a WPF UserControl works inside an Inventor DockableWindow.
         Brushes are swapped at runtime by ApplyTheme; everything else uses DynamicResource. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBack" Color="#F0F0F0" />
        <SolidColorBrush x:Key="PanelFore" Color="#000000" />
        <SolidColorBrush x:Key="ControlBack" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ControlHighlighted" Color="#E1E1E1" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PanelFore}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlHighlighted}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelFore}" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBack}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelFore}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PanelFore}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,6">
            Type in each box and watch the log. Backspace, Delete, arrows, Home/End, Tab and Ctrl+A/C/V
            should all reach the panel, and letter keys must NOT trigger Inventor shortcuts (E = Extrude, D = Dimension).
        </TextBlock>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Single-line (like Part Number)" />
            <TextBox x:Name="SingleLineBox" Text="Part-0001" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Multi-line (like Notes) - Enter and Tab should insert text" />
            <TextBox x:Name="MultiLineBox" Height="60" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="DatePicker (replaces DateTimePicker) - type a date too" />
            <DatePicker x:Name="SpikeDatePicker" Margin="0,2,0,6" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Editable ComboBox" />
            <ComboBox x:Name="SpikeCombo" IsEditable="True" Margin="0,2,0,6">
                <ComboBoxItem Content="Steel, Mild" />
                <ComboBoxItem Content="Stainless Steel" />
                <ComboBoxItem Content="Aluminium 6061" />
            </ComboBox>
        </StackPanel>

        <WrapPanel Grid.Row="5" Margin="0,0,0,6">
            <CheckBox x:Name="HookCheckBox" Content="WM_GETDLGCODE hook" IsChecked="True"
                      Checked="HookCheckBox_Changed" Unchecked="HookCheckBox_Changed" />
            <Button Content="Toggle theme" Click="ToggleTheme_Click" />
            <Button Content="Copy log" Click="CopyLog_Click" />
            <Button Content="Clear log" Click="ClearLog_Click" />
        </WrapPanel>

        <ListBox Grid.Row="6" x:Name="KeyLog" FontFamily="Consolas" FontSize="11"
                 Background="{DynamicResource ControlBack}" Foreground="{DynamicResource PanelFore}" />

        <TextBlock Grid.Row="7" x:Name="SizeText" Margin="0,6,0,0" Opacity="0.7" />
    </Grid>
</UserControl>
