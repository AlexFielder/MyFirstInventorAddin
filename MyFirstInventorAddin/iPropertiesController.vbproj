  <ItemGroup>
    <Content Include="AssemblyInfo.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>AssemblyInfo.vb</LastGenOutput>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\white_button.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\paperclip1.jpg" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\addin.ico" />
    <Resource Include="Resources\CHECKIN.png" />
    <Resource Include="Resources\CHECKOUT.png" />
    <Resource Include="Resources\green_button_tick.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\paperclip.jpg" />
  </ItemGroup>
  <ItemGroup>
    
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="1.3.0" />
    
    <PackageReference Include="Serilog.Sinks.Seq" Version="7.0.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Import Include="System.Windows" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Installer\nppBackup\**" />
    <EmbeddedResource Remove="Installer\nppBackup\**" />
    <None Remove="Installer\nppBackup\**" />
    <Page Remove="Installer\nppBackup\**" />
  </ItemGroup>
	<ItemGroup>
		<Service Include="{e691af34-cb32-4296-8cca-5d1027a27c72}" />
	</ItemGroup>
  <PropertyGroup>
    <PostBuildEvent>echo Configuration: $(Configuration)
	echo SolutionDir: $(SolutionDir)
echo OutDir: $(OutDir)
echo ProjectDir: $(ProjectDir)
echo ProjectName: $(ProjectName)
echo TargetDir: $(TargetDir)
if "$(Configuration)"=="Debug" (
XCopy "$(TargetDir)*.*" "C:\ProgramData\Autodesk\Inventor Addins\$(ProjectName)\*.*" /Y /R
if not exist "C:\Logs" mkdir "C:\Logs"
)
if "$(Configuration)"=="Release" (
cd "$(ProjectDir)\Installer"
"C:\Program Files (x86)\Inno Setup 6\ISCC.exe" "installer.iss"
)</PostBuildEvent>
    <ImportedNamespaces>System.Windows=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,iPropertiesController=True</ImportedNamespaces>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <TransformOnBuild>false</TransformOnBuild>
    <OverwriteReadOnlyOutputFiles>true</OverwriteReadOnlyOutputFiles>
    <TransformOutOfDateOnly>false</TransformOutOfDateOnly>
  </PropertyGroup>
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <!--
      T4 version bump, as in the other AF Automations Inventor/Vault add-ins. TextTransform.exe
      ships with Visual Studio, not the .NET SDK - probe the usual install locations and SKIP
      gracefully when absent (CI runners, SDK-only machines): AssemblyInfo.vb is tracked, so a
      build without the bump just reuses the committed version.
    -->
    <PropertyGroup>
      <TextTransformExe>C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\IDE\TextTransform.exe</TextTransformExe>
      <TextTransformExe Condition="!Exists('$(TextTransformExe)')">C:\Program Files\Microsoft Visual Studio\2022\Enterprise\Common7\IDE\TextTransform.exe</TextTransformExe>
      <TextTransformExe Condition="!Exists('$(TextTransformExe)')">C:\Program Files\Microsoft Visual Studio\2022\Professional\Common7\IDE\TextTransform.exe</TextTransformExe>
      <TextTransformExe Condition="!Exists('$(TextTransformExe)')">C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\TextTransform.exe</TextTransformExe>
      <TextTransformExe Condition="!Exists('$(TextTransformExe)')">C:\Program Files\Microsoft Visual Studio\18\Professional\Common7\IDE\TextTransform.exe</TextTransformExe>
    </PropertyGroup>
    <Exec Condition="Exists('$(TextTransformExe)')" Command="call &quot;$(TextTransformExe)&quot; -a &quot;!!BuildConfiguration!$(Configuration)&quot; &quot;$(ProjectDir)AssemblyInfo.tt&quot;" />
    <Warning Condition="!Exists('$(TextTransformExe)')" Text="TextTransform.exe not found - skipping T4 version bump; using committed AssemblyInfo.vb as-is." />
  </Target>
</Project>