<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- AFAutomations.Licensing is distributed as a .nupkg checked in to packages/ (no private feed,
       no tokens). To update it, copy the new .nupkg there and bump the PackageReference version. -->
  <packageSources>
    <add key="afautomations-local" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="afautomations-local">
      <package pattern="AFAutomations.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
